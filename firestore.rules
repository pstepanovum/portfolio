rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Portfolio CMS collections.
    // The public website reads these through the Next.js server with the Admin SDK,
    // so client-side Firestore access can stay locked to admins only.
    match /projects/{projectId} {
      allow read, write: if isAdmin();
    }

    match /certifications/{certificationId} {
      allow read, write: if isAdmin();
    }

    match /experiences/{experienceId} {
      allow read, write: if isAdmin();
    }

    match /contacts/{contactId} {
      allow read, write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    // OAuth state for the MCP server: registered clients, authorization codes,
    // and hashed tokens. Written only by the Admin SDK, which bypasses these
    // rules; no client may ever read them.
    match /oauthClients/{clientId} {
      allow read, write: if false;
    }

    match /oauthCodes/{codeId} {
      allow read, write: if false;
    }

    match /oauthTokens/{tokenId} {
      allow read, write: if false;
    }

    // Connected mailboxes: encrypted Google refresh tokens. Admin SDK only.
    match /connections/{connectionId} {
      allow read, write: if false;
    }

    // Default deny for everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
