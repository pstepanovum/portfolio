rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Portfolio CMS collections.
    //
    // Closed to every client SDK, admin or not. Nothing in the browser reads or
    // writes Firestore: the public site and the dashboard both go through the
    // Next.js server with the Admin SDK, which ignores these rules.
    //
    // These used to allow any token carrying the `admin` custom claim. That
    // looked harmless, but the claim is on the plain Firebase ID token, which
    // is issued after the password alone. The two-factor check exists only on
    // the Next.js server, so a stolen password could sign in with the public
    // web config and read contacts and settings, or rewrite the site, straight
    // through the Firestore REST API without ever meeting the second factor.
    match /projects/{projectId} {
      allow read, write: if false;
    }

    match /certifications/{certificationId} {
      allow read, write: if false;
    }

    match /experiences/{experienceId} {
      allow read, write: if false;
    }

    match /contacts/{contactId} {
      allow read, write: if false;
    }

    match /settings/{settingId} {
      allow read, write: if false;
    }

    // OAuth state for the MCP server: registered clients, authorization codes,
    // and hashed tokens. Written only by the Admin SDK, which bypasses these
    // rules; no client may ever read them.
    match /oauthClients/{clientId} {
      allow read, write: if false;
    }

    match /oauthCodes/{codeId} {
      allow read, write: if false;
    }

    match /oauthTokens/{tokenId} {
      allow read, write: if false;
    }

    // Connected mailboxes: encrypted Google refresh tokens. Admin SDK only.
    match /connections/{connectionId} {
      allow read, write: if false;
    }

    // Admin MCP: registered custom MCP servers (encrypted bearer tokens) and
    // the tool-call activity log. Admin SDK only.
    match /customMcpServers/{serverId} {
      allow read, write: if false;
    }

    match /activity/{entryId} {
      allow read, write: if false;
    }

    // Linked banks: encrypted Plaid access tokens. Admin SDK only. No
    // transaction history is stored here, only the credential and the account
    // names needed to render the dashboard.
    match /plaidItems/{itemId} {
      allow read, write: if false;
    }

    // Two-factor secrets and recovery codes for admins. Admin SDK only.
    match /adminSecurity/{uid} {
      allow read, write: if false;
    }

    // Default deny for everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
